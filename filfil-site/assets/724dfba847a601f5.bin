<div class="about-page">
    <div class="main">
        <div class="about-history_slider">
            <div class="history_slider_tumb swiper-container">
                <div class="swiper-wrapper">
                        <div class="swiper-slide">
                            <a class="history_slider_tumb_item">
                                <span></span>
                                <label>1986</label>
                            </a>
                        </div>
                        <div class="swiper-slide">
                            <a class="history_slider_tumb_item">
