<!-- Content -->
<div class="main">
    <div class="news-detail">

        <div class="news-detail-top">
            <figure><img alt="سمبوسه" src="/content/uploads/images/samboose.jpg" style="width:884px; height:589px" /></figure>
            <div class="news-detail-top_like-date">
                <div class="news-detail-top_like-date_up">
                    <h1>سمبوسه</h1>
                    <div class="timetocook" style=""><img src="/Content/images/clock-icon.png" alt="زمان پخت" title="زمان پخت" loading="lazy"/><span>30 </span> <img src="/Content/images/eat-icon.png" loading="lazy" title="تعداد نفرات" alt="تعداد نفرات" /><span>2</span> </div>
                </div>
            </div>
            <div class="reciepe_bottom">
                    <ul class="products-list">
            <li>
                <div class="products-section__slider_item">
                    <a href="/products/detail/German-tomato/">
                        <img src="/content/uploads/images/AdminMR.Salavati%2FGerman_Tomato_matched.jpg" title="گوجه آلمانی" alt="German-tomato">
                    </a>
                    <figcaption>
                        <a href="/products/detail/German-tomato/">گوجه آلمانی</a>
                    </figcaption>
                    <div class="detail-view">
                        <a class="btn-threepoint" data-btn-alt="ادامه مطلب" href="/products/detail/German-tomato/">. . .</a>
                    </div>
                </div>
            </li>
    </ul>

                <div class="news-detail-content">
                    <p>
                        <div style="text-align:justify;"><p><span style="font-size:large;"><strong>مواد لازم برای تهیه سمبوسه:&nbsp;</strong></span><br /><span style="font-size:medium;">3 عدد سیب زمینی متوسط</span><br /><span style="font-size:medium;">1 عدد پیاز</span><br /><span style="font-size:medium;">20 گرم تره ساطوری شده</span><br /><span style="font-size:medium;">20 گرم جعفری ساطوری شده</span><br /><span style="font-size:medium;">نان لواش یا نان پیتا به مقدار لازم&nbsp;</span><br /><span style="font-size:medium;">نمک، زردچوبه و فلفل به مقدار لازم&nbsp;</span></p><p><span style="font-size:medium;"></span><br /><span style="font-size:large;"><strong>دستور پخت:&nbsp;</strong></span><br /><span style="font-size:medium;">برای تهیه سمبوسه، ابتدا سیب زمینی ها را به همراه مقداری روغن و نمک، آب پز کنید.&nbsp;</span><br /><span style="font-size:medium;">سپس پیاز را به صورت نگینی خرد کنید و روی حرارت متوسط قرار دهید تا طلایی رنگ شوند. در حین پخت به آن نمک، زردچوبه و فلفل تند اضافه کنید.&nbsp;</span><br /><span style="font-size:medium;">پس از پخته شدن سیب زمینی ها، آن را با گوشتکوب له کنید. پیاز داغ، جعفری و تره ساطوری شده را به آن اضافه کنید و به خوبی هم بزنید.&nbsp;</span><br /><span style="font-size:medium;">نان ها را به صورت مستطیلی برش بزنید. به اندازه کافی مخلوط سیب زمینی را وسط آن پخش کنید. یکی از گوشه های آن را به یک بخش نان تا کنید و به صورت مثلثی نان را جمع کنید.&nbsp;</span><br /><span style="font-size:medium;">در یک تابه عمیق، مقداری روغن اضافه کنید و به مدت 3 دقیقه آن را روی حرارت متوسط قرار دهید تا به خوبی داغ شود. سپس سمبوسه ها را داخل روغن سرخ کنید.&nbsp;</span><br /><span style="font-size:medium;">پس از پخته شدن، سمبوسه ها را با سس گوجه فیلفیل نوش جان کنید.&nbsp;</span><br /></p></div>
                    </p>

                    

                
                </div>
