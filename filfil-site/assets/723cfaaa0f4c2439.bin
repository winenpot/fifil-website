<div class="main">
    <div class="news-detail">

        <div class="news-detail-top">
            <figure><img alt="وجی کباب" src="/content/uploads/images/veggi%20kabab.jpg" style="width:884px; height:589px" /></figure>
            <div class="news-detail-top_like-date">
                <div class="news-detail-top_like-date_up">
                    <h1>وجی کباب</h1>
                    <div class="timetocook" style=""><img src="/Content/images/clock-icon.png" alt="زمان پخت" title="زمان پخت" loading="lazy"/><span>30 </span> <img src="/Content/images/eat-icon.png" loading="lazy" title="تعداد نفرات" alt="تعداد نفرات" /><span>1</span> </div>
                </div>
            </div>
            <div class="reciepe_bottom">
                    <ul class="products-list">
            <li>
