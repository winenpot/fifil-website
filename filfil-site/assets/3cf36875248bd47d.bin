    <script>
        async function getCity(value1) {
            try {
                const response = await $.ajax({
                    type: 'POST',
                    url: '/WorkWithUs/getcity',
                    dataType: 'json',
                    data: { id: value1 },
                });

                $("#CityId").empty();
                $.each(response, function (i, product) {
                    $("#CityId").append('<option value="' + product.Value + '">' + product.Text + '</option>');
                });
            } catch (ex) {
                alert('عملیات ناموفق' + ex);
            }
        }

        async function getState(value1) {
            try {
                const response = await $.ajax({
                    type: 'POST',
                    url: '/WorkWithUs/getstate',
                    dataType: 'json',
                    data: { id: value1 },
                });

                $("#StateId").empty();
                $.each(response, function (i, product) {
                    $("#StateId").append('<option value="' + product.Value + '">' + product.Text + '</option>');
                });
            } catch (ex) {
                alert('عملیات ناموفق' + ex);
            }
        }
    </script>



