            <div class="news-detail-top_like-date">
                <div class="news-detail-top_like-date_up">
                    <h1>برگر</h1>
                    <div class="timetocook" style=""><img src="/Content/images/clock-icon.png" alt="زمان پخت" title="زمان پخت" loading="lazy"/><span>40 </span> <img src="/Content/images/eat-icon.png" loading="lazy" title="تعداد نفرات" alt="تعداد نفرات" /><span>2</span> </div>
