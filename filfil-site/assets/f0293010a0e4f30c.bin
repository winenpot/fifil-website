                    </a>
                    <figcaption>
                        <a href="/products/detail/italian-recipe/">ایتالیایی</a>
                    </figcaption>
                    <div class="detail-view">
                        <a class="btn-threepoint" data-btn-alt="ادامه مطلب" href="/products/detail/italian-recipe/">. . .</a>
                    </div>
                </div>
            </li>
