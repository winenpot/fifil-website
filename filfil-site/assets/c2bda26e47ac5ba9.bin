    <script>
        let showMore = () => {

            var count = $(".products-list").children().length;
            $.ajax({
                type: "GET",
                url: "/products/show-more",
                data: { count: count },
                dataType: "json",
                success: function (response) {
                    $(".products-list").append(response);

                    var all = $("#allProductCount").val();
                    var newCount = $(".products-list").children().length;

                    if (newCount >= all) {
                        $(".detail-view-infinite").css("display", "none");
                    }
                }
            });

        }
    </script>


