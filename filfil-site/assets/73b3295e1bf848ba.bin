<div class="main">
    <div class="news-detail">

        <div class="news-detail-top">
            <figure><img alt="پیتزا بیکن" src="/content/uploads/images/Bacon%20Pizza.jpeg" style="width:884px; height:589px" /></figure>
            <div class="news-detail-top_like-date">
                <div class="news-detail-top_like-date_up">
                    <h1>پیتزا بیکن</h1>
                    <div class="timetocook" style=""><img src="/Content/images/clock-icon.png" alt="زمان پخت" title="زمان پخت" loading="lazy"/><span>90 </span> <img src="/Content/images/eat-icon.png" loading="lazy" title="تعداد نفرات" alt="تعداد نفرات" /><span>2</span> </div>
                </div>
            </div>
            <div class="reciepe_bottom">
                    <ul class="products-list">
            <li>
                <div class="products-section__slider_item">
                    <a href="/products/detail/(vegan)_Turkish_biber/">
