    <script>

        function showForm(id) {

            $('.tab-pane').attr("style", "display:none");
            $("div[id='tab-" + id + "']").removeAttr("style");
            $("div[id='tab-" + id + "']").addClass("active");

            ShowDynamicField(id);

        }

        //$("#dynamicfields"+id).html(result);
        function ShowDynamicField(id) {
              $.ajax({
                 type: "Post",
                url: "/Career/ShowDynamicFields",
                  data: { id: id },
                  cache: false,
                 success: function (result) {
                     $("#dynamicfields").html(result);

                }
            });

        }

        function getCareerId(id) {

              $.ajax({
                 type: "Get",
                url: "/Career/GetCareerId",
                  data: { id: id },
                  cache: false,
                  success: function (result) { }
                    
            });

        }

    </script>



