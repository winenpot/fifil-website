    <script>
        let showMore = () => {

            var count = $(".news-count").children().length;
            $.ajax({
                type: "GET",
                url: "/News/GetMore",
                data: { count: count },
                dataType: "json",
                success: function (response) {
                    $(".news-count").append(response);

                    var all = $("#allRecieptsCount").val();
                    var newCount = $(".news-count").children().length;

                    if (newCount >= all) {
                        $(".detail-view-infinite").css("display", "none");
                    }
                }
            });

        }
    </script>



